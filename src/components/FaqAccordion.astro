---
interface Props {
    title?: string;
    titleClass?: string;
}

const {
    title = "Frequently Asked Questions",
    titleClass = "text-3xl font-medium text-center text-primary mb-8",
} = Astro.props;

const questions = [
    {
        question: "What is LatteArtist?",
        answer: "LatteArtist is a personal latte art practice journal for iPhone. It keeps your pour photos and the context you choose in one history, so you can revisit attempts and compare how a pattern changes over time.",
    },
    {
        question: "What can I record for each pour?",
        answer: "You can save a photo and log the pattern, your own rating, milk, cup, volume, and notes. You can also browse past pours by pattern.",
    },
    {
        question: "Does LatteArtist grade or diagnose my latte art?",
        answer: "No. LatteArtist does not automatically score a photo, diagnose a problem, or teach pouring technique. It gives you a structured practice record; you decide what the result means and what to try next.",
    },
    {
        question: "Can I share or back up my pours?",
        answer: "Yes. You can create a polished Pour Card to save or share, and the app includes export and restore tools for your practice history.",
    },
    {
        question: "Which devices are supported?",
        answer: "The current App Store release is for iPhone and requires iOS 18.0 or later.",
    },
];
---

<h2 class={titleClass}>{title}</h2>
<div class="space-y-4">
    {questions.map(({ question, answer }) => (
        <details class="group rounded-2xl border border-gray-100 bg-card shadow-lg shadow-black/5 transition duration-300 ease-in-out hover:border-accent/30 dark:border-gray-800 dark:shadow-none">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6">
                <span class="font-medium text-primary">{question}</span>
                <span class="text-secondary transition-transform duration-200 group-open:rotate-180" aria-hidden="true">⌄</span>
            </summary>
            <p class="px-6 pb-6 leading-relaxed text-secondary">{answer}</p>
        </details>
    ))}
</div>
