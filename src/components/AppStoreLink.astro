---
interface Props {
    placement: string;
    ctaVariant: string;
    class?: string;
}

const {
    placement,
    ctaVariant,
    class: className,
} = Astro.props;

const appStoreUrl =
    "https://apps.apple.com/app/apple-store/id6744374882?pt=127751558&ct=website&mt=8";
---

<a
    href={appStoreUrl}
    target="_blank"
    rel="noopener noreferrer"
    data-app-store-link
    data-umami-placement={placement}
    data-umami-cta-variant={ctaVariant}
    class={className}
>
    <slot />
</a>
