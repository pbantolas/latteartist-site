---
const features = [
    ["Capture every pour", "Save a photo from the camera or your library, then add a note."],
    ["Log the setup", "Record the pattern, your rating, milk, cup, and volume."],
    ["Focus on a pattern", "Keep the heart, tulip, or rosetta you are practising front and centre."],
    ["Compare progress", "See where a pattern started alongside your latest attempt."],
    ["Browse and share", "Revisit pours by pattern and create a Pour Card for the ones you want to share."],
    ["Keep a backup", "Export and restore your practice history."],
];
---

<section aria-labelledby="features-heading">
    <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Inside LatteArtist</p>
        <h2 id="features-heading" class="mt-3 text-3xl font-semibold tracking-tight text-primary sm:text-5xl">Everything around the pour, in one place.</h2>
        <p class="mt-5 text-lg text-secondary">A simple record of what you poured, what you used, and how the pattern is moving over time.</p>
    </div>

    <ul class="mt-9 grid gap-x-10 gap-y-8 border-y border-black/5 py-9 md:grid-cols-2 dark:border-white/10">
        {features.map(([title, body], index) => (
            <li class="grid grid-cols-[2rem_1fr] gap-3">
                <span class="pt-1 text-xs font-semibold tracking-wider text-accent">0{index + 1}</span>
                <div>
                    <h3 class="text-xl font-semibold text-primary">{title}</h3>
                    <p class="mt-2 text-secondary">{body}</p>
                </div>
            </li>
        ))}
    </ul>
</section>
