---
interface Props {
    title?: string;
    description?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogUrl?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    twitterImage?: string;
    type?: "website" | "article";
    imageAlt?: string;
    canonical?: string;
    structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    title = "LatteArtist: A Latte Art Practice Journal for iPhone",
    description = "Photograph each pour, log the details, and compare your latte art practice over time with LatteArtist for iPhone.",
    ogTitle = title,
    ogDescription = description,
    ogImage = "https://latteartist.coffeeatpetros.com/assets/card-image.jpg",
    ogUrl,
    twitterTitle = ogTitle,
    twitterDescription = ogDescription,
    twitterImage = "https://latteartist.coffeeatpetros.com/assets/card-image.webp",
    type = "website",
    imageAlt = "LatteArtist latte art practice journal",
    canonical,
    structuredData,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://latteartist.coffeeatpetros.com");
const canonicalURL = new URL(canonical ?? ogUrl ?? Astro.url.pathname, siteURL);
canonicalURL.search = "";
canonicalURL.hash = "";
const schemas = structuredData
    ? Array.isArray(structuredData)
        ? structuredData
        : [structuredData]
    : [];
---

<!-- SEO Meta Tags -->
<meta name="description" content={description} />
<title>{title}</title>

<!-- Open Graph Meta Tags -->
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="LatteArtist" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={twitterTitle} />
<meta name="twitter:description" content={twitterDescription} />
<meta name="twitter:image" content={twitterImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{
    schemas.map((schema) => (
        <script
            type="application/ld+json"
            set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
    ))
}
