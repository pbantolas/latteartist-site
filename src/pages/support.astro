---
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
---

<Layout
    title="LatteArtist Support"
    description="Get help with LatteArtist, the personal latte art practice journal for iPhone. Find common answers or contact support."
    ogTitle="LatteArtist Support"
    ogDescription="Get help with LatteArtist, the personal latte art practice journal for iPhone."
    twitterTitle="LatteArtist Support"
    twitterDescription="Get help with LatteArtist, the personal latte art practice journal for iPhone."
>
    <div class="max-w-4xl mx-auto px-4 mb-4">
        <h1
            class="text-4xl md:text-5xl font-semibold mb-4 text-title-light dark:text-title-dark"
        >
            LatteArtist Support
        </h1>

        <div
            class="prose dark:prose-invert max-w-none prose-p:text-foreground prose-headings:text-title-light dark:prose-headings:text-title-dark prose-a:text-link hover:prose-a:text-link-hover prose-strong:text-foreground"
        >
            <h2>About LatteArtist</h2>
            <p>
                LatteArtist is a personal latte art practice journal for iPhone. You can photograph pours, record the pattern and setup, browse your history, and compare your first and latest attempts for a focused pattern.
            </p>

            <h2>Getting Support</h2>
            <p>
                If you need help with the LatteArtist app, have questions about features, or want to report an issue, please contact us at:
            </p>
            <p>
                <strong>Email:</strong> <a href="mailto:petros@coffeeatpetros.com">petros@coffeeatpetros.com</a>
            </p>
            <p>
                We typically respond to support requests within 24-48 hours. Please include details about:
            </p>
            <ul>
                <li>The device you're using (iPhone model, iOS version)</li>
                <li>The app version you're running</li>
                <li>A description of the issue or question</li>
                <li>Steps to reproduce the problem (if applicable)</li>
            </ul>

            <div class="mb-8">
                <FaqAccordion 
                    title="Common Questions" 
                    titleClass="text-2xl font-medium text-primary mb-8"
                />
            </div>
            <p>
                If your question isn't covered above, please don't hesitate to reach out at <a href="mailto:petros@coffeeatpetros.com">petros@coffeeatpetros.com</a>. We're always looking to improve the app based on user feedback.
            </p>

            <h2>Privacy & Data</h2>
            <p>
                For details about analytics and data handling, review the <a href="/privacy-policy/">Privacy Policy</a> and the App Privacy section on the App Store listing.
            </p>

        </div>
    </div>
</Layout>
