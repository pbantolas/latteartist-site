---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const releases = (await getCollection("releases")).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const rendered = await Promise.all(
	releases.map(async (release) => {
		const { Content } = await release.render();
		return { ...release, Content };
	})
);

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});

const description =
	"Every LatteArtist update, from the first release to today. New features, improvements, and fixes for the iOS latte art tracker.";
---

<Layout
	title="LatteArtist Releases: Version History & Changelog"
	description={description}
	ogTitle="LatteArtist Releases: What's New in Each Version"
	ogDescription={description}
	twitterTitle="LatteArtist Releases: Version History & Changelog"
	twitterDescription={description}
>
<div class="mx-auto w-full max-w-2xl">
	<h1
		class="text-4xl md:text-5xl font-semibold mb-4 text-title-light dark:text-title-dark"
	>
		Releases
	</h1>
	<p class="text-lg font-light text-secondary mb-12">
		{description}
	</p>

	<ol class="relative ml-3 border-l-2 border-accent/15 dark:border-accent/20">
		{
			rendered.map((release, index) => (
				<li
					class="relative mb-12 last:mb-0 pl-8 md:pl-10 opacity-0 animate-fadeInUp"
					style={`animation-delay: ${index * 90}ms`}
				>
					{/* Timeline dot */}
					<span
						class:list={[
							"absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-2",
							index === 0
								? "bg-accent border-accent shadow-brand-glow"
								: "bg-card border-accent/40",
						]}
						aria-hidden="true"
					/>

					<div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-1">
						<span class="inline-flex items-center rounded-full bg-accent px-3 py-1 text-sm font-semibold text-on-accent tabular-nums">
							{release.data.version}
						</span>
						{index === 0 && (
							<span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-xs font-medium uppercase tracking-wide text-accent">
								Latest
							</span>
						)}
						<time
							datetime={release.data.pubDate.toISOString().slice(0, 10)}
							class="text-sm text-secondary tabular-nums"
						>
							{formatDate(release.data.pubDate)}
						</time>
					</div>

					<h2 class="text-xl md:text-2xl font-medium mb-3 text-title-light dark:text-title-dark text-balance">
						{release.data.title}
					</h2>

					<div class="prose dark:prose-invert max-w-none prose-p:text-secondary prose-li:text-secondary prose-ul:my-0 prose-li:my-1 prose-li:marker:text-accent">
						<release.Content />
					</div>
				</li>
			))
		}
	</ol>
</div>
</Layout>
