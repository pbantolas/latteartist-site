---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import GuideCard from "../../components/GuideCard.astro";
import { guideSlug } from "../../lib/guides";

const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
const collectionSchema = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Latte art guides",
    description: "Practical latte art guides for milk texture, beginner pours, troubleshooting, and deliberate practice.",
    url: new URL("/learn/", Astro.site).href,
    hasPart: guides.map((guide) => ({
        "@type": "Article",
        name: guide.data.title,
        url: new URL(`/learn/${guideSlug(guide.id)}/`, Astro.site).href,
    })),
};
---

<Layout
    title="Latte Art Guides: Milk, Hearts, Troubleshooting & Practice"
    description="Learn latte art from the foundations: texture silky microfoam, pour your first heart, diagnose common problems, and build a repeatable practice routine."
    canonical="/learn/"
    structuredData={collectionSchema}
>
    <section class="mx-auto w-full max-w-6xl">
        <header class="max-w-4xl py-8 sm:py-14">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Latte art field notes</p>
            <h1 class="mt-4 text-4xl font-semibold leading-[1.03] tracking-[-0.04em] text-primary sm:text-6xl lg:text-7xl">Better milk. Cleaner pours.</h1>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary sm:text-xl">Practical notes on texture, flow, placement, and the problems that show up in the cup.</p>
        </header>

        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {guides.map((guide) => (
                <GuideCard
                    href={`/learn/${guideSlug(guide.id)}/`}
                    eyebrow={guide.data.eyebrow}
                    title={guide.data.title}
                    description={guide.data.description}
                    readTime={guide.data.readTime}
                />
            ))}
        </div>

    </section>
</Layout>
