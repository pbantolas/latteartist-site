---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import ImageColumn from "../components/ImageColumn.astro";
import FeaturesCard from "../components/FeaturesCard.astro";
import SignupForm from "../components/SignupForm.astro";
import TrustSection from "../components/TrustSection.astro";
import FaqAccordion from "../components/FaqAccordion.astro"; // Added FAQ component import
---

<Layout>
    <section class="w-full max-w-5xl mx-auto px-4">
        <div class="md:flex md:gap-8">
            {/* Left column - text and primary action */}
            <div class="md:w-3/5 md:mt-8 animate-fadeInUp opacity-0">
                <h1 class="text-2xl md:text-4xl font-bold mb-6">
                    Stop Guessing With Your Latte Art.
                </h1>
                <p class="text-lg md:text-xl font-light text-secondary mb-4">
                    No more wondering why yesterday's heart was perfect but
                    today's is jaggy.
                </p>
                <p class="text-lg md:text-xl font-light text-secondary mb-4">
                    LatteArtist logs your photos, technique notes, and ratings
                    so you remember what creates perfect pours.
                </p>
                <p class="text-lg md:text-xl font-light text-secondary mb-4">
                    Now available on the App Store.
                </p>
                <div class="mb-8">
                    <a
                        href="https://apps.apple.com/us/app/latte-art-tracker-latteartist/id6744374882?itscg=30200&itsct=apps_box_link&mttnsubad=6744374882"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <img
                            src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg"
                            alt="Download on the App Store"
                            class="h-12"
                        />
                    </a>
                </div>
            </div>

            {/* Right column - image */}
            <div class="mt-8 md:mt-0 md:w-2/5">
                <ImageColumn />
            </div>
        </div>
    </section>

    <div class="max-w-4xl mx-auto px-4">
        <div class="mt-16 md:mt-20 lg:mt-24">
            <FeaturesCard />
        </div>
        <div class="mt-16 md:mt-20 lg:mt-24">
            <TrustSection />
        </div>
        {/* Added FAQ component inside main */}
        <div class="mt-16 md:mt-20 lg:mt-24">
            <FaqAccordion />
        </div>
        <div class="mt-16 md:mt-20 lg:mt-24">
            <SignupForm />
        </div>
    </div>
</Layout>
