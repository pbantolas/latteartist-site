---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ImageColumn from "../components/ImageColumn.astro";
import FeaturesCard from "../components/FeaturesCard.astro";
import TrustSection from "../components/TrustSection.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import SignupForm from "../components/SignupForm.astro";
import GuideCard from "../components/GuideCard.astro";
import AppStoreLink from "../components/AppStoreLink.astro";
import { guideSlug } from "../lib/guides";

const featuredGuides = (await getCollection("guides"))
    .filter((guide) => guide.data.featured)
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 3);

const homeSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "LatteArtist",
    url: Astro.site?.href,
    description: "A latte art practice journal for iPhone, plus practical guides for home baristas.",
};
---

<Layout
    title="Latte Art Tracker & Practice Journal | LatteArtist"
    description="Save each latte art pour, note your setup, and compare progress by pattern with LatteArtist for iPhone."
    canonical="/"
    structuredData={homeSchema}
    pageType="home"
    topic="latte_art_practice"
>
    <section class="mx-auto w-full max-w-5xl px-4">
        <div class="md:flex md:items-center md:gap-8">
            <div class="animate-fadeInUp opacity-0 md:w-3/5">
                <div class="flex items-center gap-4">
                    <img src="/assets/app-store/app-icon.png" alt="LatteArtist app icon" width="64" height="64" class="h-14 w-14 rounded-2xl shadow-lg" />
                    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Latte art practice journal for iPhone</p>
                </div>
                <h1 class="mt-8 max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.05em] text-primary sm:text-6xl lg:text-7xl">Track every latte art pour.</h1>
                <p class="mt-7 max-w-xl text-lg leading-relaxed text-secondary sm:text-xl">Stop losing your practice in the camera roll. Save each pour with its milk, cup, pattern and notes, then compare how your latte art changes over time.</p>
                <p class="mt-4 max-w-xl text-base leading-relaxed text-secondary">A practice journal, not an automatic AI grader. Your photos and setup details make it easier to spot what is improving in each pattern.</p>
                <div class="mt-8 flex flex-wrap gap-4">
                    <AppStoreLink placement="hero" ctaVariant="primary" class="rounded-full bg-accent px-6 py-3.5 font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-xl">View on the App Store</AppStoreLink>
                    <a href="/learn/" class="rounded-full border border-black/10 bg-card px-6 py-3.5 font-semibold text-primary transition hover:border-accent/30 dark:border-white/15">Read the guides</a>
                </div>
            </div>
            <div class="mx-auto mt-8 w-full max-w-sm md:mt-0 md:w-2/5 md:max-w-none">
                <ImageColumn />
            </div>
        </div>
    </section>

    <div class="mx-auto mt-20 w-full max-w-6xl"><FeaturesCard /></div>

    <section class="mx-auto mt-20 w-full max-w-6xl" aria-labelledby="learn-heading">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Latte art field notes</p>
                <h2 id="learn-heading" class="mt-3 text-3xl font-semibold tracking-tight text-primary sm:text-5xl">Start with what showed up in the cup.</h2>
            </div>
            <a href="/learn/" class="font-semibold text-accent">All guides →</a>
        </div>
        <div class="mt-9 grid gap-5 md:grid-cols-3">
            {featuredGuides.map((guide) => (
                <GuideCard
                    href={`/learn/${guideSlug(guide.id)}/`}
                    eyebrow={guide.data.eyebrow}
                    title={guide.data.title}
                    description={guide.data.description}
                    readTime={guide.data.readTime}
                />
            ))}
        </div>
    </section>

    <div class="mx-auto mt-20 w-full max-w-6xl"><TrustSection /></div>

    <section class="mx-auto mt-20 w-full max-w-4xl" aria-label="Common questions"><FaqAccordion /></section>

    <section class="mx-auto mt-16 w-full max-w-4xl rounded-3xl border border-black/5 bg-card px-6 py-10 text-center shadow-lg shadow-black/5 sm:px-10 md:mt-20 lg:mt-24 dark:border-white/10 dark:shadow-none" aria-labelledby="download-heading">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Your next practice session</p>
        <h2 id="download-heading" class="mt-3 text-3xl font-semibold tracking-tight text-primary sm:text-4xl">Keep your pours somewhere useful.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-secondary">LatteArtist is the iPhone journal for pour photos, setup details and pattern-by-pattern progress.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-4">
            <AppStoreLink placement="bottom_cta" ctaVariant="primary" class="rounded-full bg-accent px-6 py-3.5 font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-xl">Download on the App Store</AppStoreLink>
            <a href="/learn/" class="rounded-full border border-black/10 bg-card px-6 py-3.5 font-semibold text-primary transition hover:border-accent/30 dark:border-white/15">Read practical guides</a>
        </div>
    </section>

    <div class="mx-auto mt-16 w-full max-w-4xl md:mt-20 lg:mt-24"><SignupForm /></div>
</Layout>
