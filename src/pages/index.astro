---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GuideCard from "../components/GuideCard.astro";
import { guideSlug } from "../lib/guides";

const featuredGuides = (await getCollection("guides"))
    .filter((guide) => guide.data.featured)
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 3);

const appStoreUrl = "https://apps.apple.com/us/app/latte-art-tracker-latteartist/id6744374882";
const homeSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "LatteArtist",
    url: Astro.site?.href,
    description: "A latte art practice journal for iPhone, plus practical guides for home baristas.",
};
---

<Layout
    title="LatteArtist: Track Latte Art Practice, Pour by Pour"
    description="Save each latte art pour, note your setup, and compare progress by pattern with LatteArtist for iPhone."
    canonical="/"
    structuredData={homeSchema}
>
    <section class="mx-auto w-full max-w-6xl">
        <div class="max-w-5xl py-8 sm:py-14">
            <div class="flex items-center gap-4 animate-fadeInUp opacity-0">
                <img src="/assets/app-store/app-icon.png" alt="LatteArtist app icon" width="64" height="64" class="h-14 w-14 rounded-2xl shadow-lg" />
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Latte art practice journal for iPhone</p>
            </div>
            <h1 class="mt-8 max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.05em] text-primary sm:text-7xl lg:text-8xl">Keep track of every pour.</h1>
            <p class="mt-7 max-w-2xl text-lg leading-relaxed text-secondary sm:text-xl">Save each attempt, note your setup, and compare your progress by pattern over time.</p>
            <div class="mt-8 flex flex-wrap gap-4">
                <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-accent px-6 py-3.5 font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-xl">View on the App Store</a>
                <a href="/learn" class="rounded-full border border-black/10 bg-card px-6 py-3.5 font-semibold text-primary transition hover:border-accent/30 dark:border-white/15">Read the guides</a>
            </div>
        </div>
    </section>

    <section class="mx-auto mt-16 w-full max-w-6xl border-y border-black/5 py-10 dark:border-white/10" aria-label="LatteArtist features">
        <div class="grid gap-8 md:grid-cols-3">
            <div><h2 class="text-xl font-semibold text-primary">Log the pour</h2><p class="mt-2 text-secondary">Save a photo, pattern, and your own rating.</p></div>
            <div><h2 class="text-xl font-semibold text-primary">Note the setup</h2><p class="mt-2 text-secondary">Record the milk, cup, volume, and a short note.</p></div>
            <div><h2 class="text-xl font-semibold text-primary">Compare by pattern</h2><p class="mt-2 text-secondary">Browse your history and see your first and latest attempts.</p></div>
        </div>
    </section>

    <section class="mx-auto mt-20 w-full max-w-6xl" aria-labelledby="learn-heading">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Learn the craft</p>
                <h2 id="learn-heading" class="mt-3 text-3xl font-semibold tracking-tight text-primary sm:text-5xl">Start with what showed up in the cup.</h2>
            </div>
            <a href="/learn" class="font-semibold text-accent">All guides →</a>
        </div>
        <div class="mt-9 grid gap-5 md:grid-cols-3">
            {featuredGuides.map((guide) => (
                <GuideCard
                    href={`/learn/${guideSlug(guide.id)}`}
                    eyebrow={guide.data.eyebrow}
                    title={guide.data.title}
                    description={guide.data.description}
                    readTime={guide.data.readTime}
                />
            ))}
        </div>
    </section>
</Layout>
