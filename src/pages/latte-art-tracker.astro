---
import Layout from "../layouts/Layout.astro";
import AppStoreCta from "../components/AppStoreCta.astro";

const appStoreUrl = "https://apps.apple.com/us/app/latte-art-tracker-latteartist/id6744374882";
const screenshots = [
    { src: "/assets/app-store/improve-latte-art.webp", alt: "LatteArtist comparing the first and latest tulip pours with a progress graph" },
    { src: "/assets/app-store/track-pours.webp", alt: "LatteArtist home screen showing a focused pattern and recent pours" },
    { src: "/assets/app-store/log-pour.webp", alt: "LatteArtist new pour screen for pattern, rating, milk, cup, and notes" },
    { src: "/assets/app-store/browse-pours.webp", alt: "LatteArtist history gallery filtered to heart pours" },
    { src: "/assets/app-store/share-pour.webp", alt: "A polished LatteArtist Pour Card ready to share" },
];

const softwareSchema = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Latte Art Tracker: LatteArtist",
    alternateName: "LatteArtist",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS 18.0 or later",
    description: "A personal latte art practice journal for capturing pours, recording context, and comparing progress over time.",
    url: new URL("/latte-art-tracker/", Astro.site).href,
    downloadUrl: appStoreUrl,
    image: new URL("/assets/app-store/app-icon.png", Astro.site).href,
    author: { "@type": "Person", name: "Petros Bantolas" },
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout
    title="Latte Art Tracker & Practice Journal for iPhone | LatteArtist"
    description="Capture every latte art pour, log pattern and setup details, compare progress, browse your history, and share Pour Cards with LatteArtist for iPhone."
    canonical="/latte-art-tracker/"
    structuredData={softwareSchema}
    imageAlt="LatteArtist latte art tracker screens on iPhone"
>
    <section class="mx-auto w-full max-w-6xl">
        <div class="grid items-center gap-10 lg:grid-cols-[1fr_0.9fr]">
            <div class="animate-fadeInUp opacity-0">
                <div class="flex items-center gap-4">
                    <img src="/assets/app-store/app-icon.png" alt="LatteArtist app icon" width="80" height="80" class="h-16 w-16 rounded-2xl shadow-lg" />
                    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Practice & improve pours</p>
                </div>
                <h1 class="mt-7 max-w-3xl text-4xl font-semibold leading-[1.02] tracking-[-0.04em] text-primary sm:text-6xl lg:text-7xl">
                    Your latte art practice, one pour at a time.
                </h1>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary sm:text-xl">
                    LatteArtist is a simple iPhone journal for home baristas. Save each pour, record the context, and make your progress easier to see.
                </p>
                <div class="mt-8 flex flex-wrap items-center gap-4">
                    <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-accent px-6 py-3.5 font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-xl">View on the App Store</a>
                    <a href="/learn/latte-art-practice-routine" class="rounded-full border border-black/10 bg-card px-6 py-3.5 font-semibold text-primary transition hover:border-accent/30 dark:border-white/15">Build a practice routine</a>
                </div>
                <p class="mt-5 text-sm text-secondary">Free · For iPhone · Requires iOS 18.0 or later</p>
            </div>

            <div class="product-phone-stage" aria-label="LatteArtist app preview">
                <img src={screenshots[0].src} alt={screenshots[0].alt} width="642" height="1389" class="product-phone product-phone--back" />
                <img src={screenshots[1].src} alt={screenshots[1].alt} width="642" height="1389" class="product-phone product-phone--front" />
            </div>
        </div>

        <section class="mt-20" aria-labelledby="features-heading">
            <div class="max-w-3xl">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">What the app does</p>
                <h2 id="features-heading" class="mt-3 text-3xl font-semibold tracking-tight text-primary sm:text-5xl">A calmer record of the work.</h2>
                <p class="mt-5 text-lg text-secondary">No invented coaching claims. These are the features listed in the current App Store version.</p>
            </div>
            <div class="mt-9 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                {[
                    ["Capture every pour", "Take a photo or choose one from your library and save it to your latte art history."],
                    ["Record the context", "Log the pattern, your own rating, milk, cup, volume, and notes for each attempt."],
                    ["Focus on a pattern", "Keep the pattern you are practising visible and compare where you started with your latest pour."],
                    ["Review your history", "Browse past attempts by pattern and revisit the details you recorded."],
                    ["Share your best", "Create a polished Pour Card to save or share with friends and the barista community."],
                    ["Export and restore", "Keep a backup of your practice history and restore it when needed."],
                ].map(([title, body], index) => (
                    <article class="rounded-3xl border border-black/5 bg-card p-6 shadow-[0_16px_50px_rgba(22,22,26,0.05)] dark:border-white/10 dark:shadow-none">
                        <span class="text-sm font-semibold text-accent">0{index + 1}</span>
                        <h3 class="mt-5 text-2xl font-semibold text-primary">{title}</h3>
                        <p class="mt-3 text-secondary">{body}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="mt-20" aria-labelledby="screens-heading">
            <div class="text-center">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Inside LatteArtist</p>
                <h2 id="screens-heading" class="mt-3 text-3xl font-semibold tracking-tight text-primary sm:text-5xl">From attempt to history.</h2>
            </div>
            <div class="screenshot-rail mt-10">
                {screenshots.map((shot, index) => (
                    <figure>
                        <img src={shot.src} alt={shot.alt} width="642" height="1389" loading={index < 2 ? "eager" : "lazy"} />
                    </figure>
                ))}
            </div>
        </section>

        <section class="mt-20 grid gap-8 rounded-[2rem] bg-card p-8 md:grid-cols-2 md:p-12" aria-labelledby="honest-heading">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Clear boundaries</p>
                <h2 id="honest-heading" class="mt-3 text-3xl font-semibold text-primary">A journal, not an automatic judge.</h2>
            </div>
            <div class="space-y-4 text-lg text-secondary">
                <p>LatteArtist does not use AI to score a photo, teach pouring technique, or diagnose a failed pattern.</p>
                <p>Use the app to keep evidence of your practice. Use the <a href="/learn" class="font-semibold text-accent underline decoration-accent/30 underline-offset-4">latte art guides</a>, your own observations, and trusted instruction to decide what to try next.</p>
            </div>
        </section>

        <div class="mt-20">
            <AppStoreCta heading="Start tracking your latte art practice" body="Save the next pour, add the details that matter to you, and let the history build." />
        </div>
    </section>
</Layout>

<style>
    .product-phone-stage {
        position: relative;
        min-height: min(72vw, 42rem);
        border-radius: 2.5rem;
        background: radial-gradient(circle at 50% 35%, rgba(51, 48, 228, 0.16), transparent 58%);
    }

    .product-phone {
        position: absolute;
        width: min(55%, 20rem);
        height: auto;
        border-radius: 2rem;
        filter: drop-shadow(0 28px 35px rgb(0 0 0 / 0.16));
    }

    .product-phone--back { left: 8%; top: 8%; transform: rotate(-6deg); }
    .product-phone--front { right: 7%; top: 1%; transform: rotate(5deg); }

    .screenshot-rail {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(15rem, 18rem);
        gap: 1.25rem;
        overflow-x: auto;
        padding: 1rem 1rem 2rem;
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
    }

    .screenshot-rail figure { scroll-snap-align: start; }
    .screenshot-rail img { width: 100%; height: auto; border-radius: 2rem; box-shadow: 0 24px 50px rgb(0 0 0 / 0.13); }

    @media (max-width: 1023px) {
        .product-phone-stage { min-height: min(120vw, 44rem); }
    }
</style>
