---
// src/layouts/Layout.astro
import { ClientRouter } from "astro:transitions";

// Supports weights 100-900
import "@fontsource-variable/outfit";
import "../styles/global.css";
import NavigationLinks from "../components/NavigationLinks.astro"; // Import the navigation component
import AppStoreLink from "../components/AppStoreLink.astro";
interface Props {
    title?: string;
    description?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogUrl?: string;
    twitterTitle?: string;
    twitterDescription?: string;
    twitterImage?: string;
    noIndex?: boolean;
    type?: "website" | "article";
    imageAlt?: string;
    canonical?: string;
    structuredData?: Record<string, unknown> | Record<string, unknown>[];
    pageType?: string;
    topic?: string;
}

import Seo from "../components/Seo.astro";
import { getCollection } from "astro:content";
import { guideSlug } from "../lib/guides";

const footerGuides = (await getCollection("guides"))
    .filter((guide) => guide.data.featured)
    .sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en" data-theme="light">
    <!-- Add data-theme for selector strategy -->
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- Mobile Safari Background Color -->
        <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
        />
        <meta name="theme-color" content="#fafafa" id="theme-color-meta" />
        <meta name="apple-itunes-app" content="app-id=6744374882" />

        <Seo {...Astro.props} />
        {
            Astro.props.noIndex && (
                <meta name="robots" content="noindex, nofollow" />
            )
        }

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- View Transitions -->
        <ClientRouter />

        <!-- Theme Sync Script (Sets data-theme based on OS preference and updates theme-color meta tag) -->
        <script is:inline>
            const getPreferredTheme = () => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            };

            const applyTheme = (theme) => {
                document.documentElement.setAttribute("data-theme", theme);
                // Update theme-color meta tag
                const themeColorMeta =
                    document.getElementById("theme-color-meta");
                if (themeColorMeta) {
                    const computedStyle = getComputedStyle(
                        document.documentElement
                    );
                    const bgColor = computedStyle
                        .getPropertyValue(
                            theme === "dark"
                                ? "--bg-gradient-start-dark"
                                : "--bg-gradient-start"
                        )
                        .trim();
                    themeColorMeta.setAttribute(
                        "content",
                        bgColor || (theme === "dark" ? "#1c1c1e" : "#fafafa")
                    );
                }
            };

            // Initial load
            const theme = getPreferredTheme();
            applyTheme(theme);

            // OS theme change listener
            window
                .matchMedia("(prefers-color-scheme: dark)")
                .addEventListener("change", (e) => {
                    applyTheme(e.matches ? "dark" : "light");
                });

            // Astro client-side navigation fix
            document.addEventListener("astro:after-swap", () => {
                applyTheme(getPreferredTheme());
            });
        </script>

        {/* Analytics Tracking (Loads only in production) */}
        {
            import.meta.env.PROD && (
                <script
                    defer
                    src="https://umami.bantolas.dev/script.js"
                    data-website-id="12fb4b5f-07e5-4a7a-a1d6-1381ef5a2feb"
                />
            )
        }
    </head>
    <body
        class="font-sans text-primary bg-gradient-to-b from-gradient-start to-gradient-end flex flex-col items-center min-h-screen p-2 leading-relaxed transition-colors duration-300 ease-in-out"
        data-page-type={Astro.props.pageType ?? "site"}
        data-topic={Astro.props.topic ?? "general"}
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
        >
            Skip to content
        </a>
        <!-- Fixed Navigation Bar -->
        <header
            class="fixed top-0 left-0 w-screen z-50 transition-colors duration-300 ease-in-out"
        >
            <NavigationLinks />
        </header>

        {/* Add pt-16 to push content below the fixed nav */}
        <div class="w-full mx-auto px-4 flex flex-col flex-grow pt-20 lg:pt-24">
            <main id="main-content" class="w-full">
                <slot />
            </main>
            <footer
                class="mt-16 md:mt-20 lg:mt-24 py-10 text-sm text-secondary w-full border-t border-gray-200 dark:border-gray-700 transition-colors duration-300 ease-in-out"
            >
                <div class="mx-auto grid w-full max-w-6xl gap-10 sm:grid-cols-[1.2fr_1fr_1fr]">
                    <div>
                        <a href="/" class="font-semibold text-primary">LatteArtist</a>
                        <p class="mt-2 max-w-xs">A simple latte art practice journal for iPhone.</p>
                        <AppStoreLink
                            placement="footer"
                            ctaVariant="text_link"
                            class="mt-4 inline-block font-semibold text-accent"
                        >
                            View on the App Store →
                        </AppStoreLink>
                    </div>
                    <nav aria-label="Guides">
                        <p class="font-semibold text-primary">Learn</p>
                        <div class="mt-3 flex flex-col gap-2">
                            <a href="/learn/" class="hover:text-accent">All guides</a>
                            {footerGuides.map((guide) => (
                                <a href={`/learn/${guideSlug(guide.id)}/`} class="hover:text-accent">
                                    {guide.data.footerLabel ?? guide.data.title}
                                </a>
                            ))}
                        </div>
                    </nav>
                    <nav aria-label="Site">
                        <p class="font-semibold text-primary">LatteArtist</p>
                        <div class="mt-3 flex flex-col gap-2">
                            <a href="/support/" class="hover:text-accent">Support</a>
                            <a href="/privacy-policy/" class="hover:text-accent">Privacy</a>
                        </div>
                    </nav>
                </div>
                <div class="mx-auto mt-12 flex w-full max-w-6xl items-center justify-between border-t border-gray-200 pt-6 text-xs dark:border-gray-700">
                    <p>© {new Date().getFullYear()} LatteArtist</p>
                    <p>Made for home baristas.</p>
                </div>
            </footer>
        </div>
        <script is:inline>
            if (!window.__latteArtistAnalyticsInitialized) {
                window.__latteArtistAnalyticsInitialized = true;

                document.addEventListener("click", (event) => {
                    if (!(event.target instanceof Element)) return;

                    const link = event.target.closest(
                        "a[data-app-store-link]"
                    );
                    if (!link) return;

                    window.umami?.track("app_store_click", {
                        placement: link.dataset.umamiPlacement,
                        page_type: document.body.dataset.pageType ?? "site",
                        topic: document.body.dataset.topic ?? "general",
                        cta_variant: link.dataset.umamiCtaVariant,
                        destination: "app_store",
                    });
                });

                let cleanupAppStoreCtaSeen = () => {};

                const setupAppStoreCtaSeen = () => {
                    cleanupAppStoreCtaSeen();

                    const links = document.querySelectorAll(
                        "a[data-app-store-link]"
                    );
                    if (
                        !links.length ||
                        typeof IntersectionObserver === "undefined"
                    ) {
                        return;
                    }

                    const seenLinks = new WeakSet();
                    const observer = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (
                                    !entry.isIntersecting ||
                                    entry.intersectionRatio < 0.5
                                ) {
                                    return;
                                }

                                const link = entry.target;
                                if (seenLinks.has(link)) return;

                                seenLinks.add(link);
                                observer.unobserve(link);
                                window.umami?.track("app_store_cta_seen", {
                                    placement: link.dataset.umamiPlacement,
                                    page_type:
                                        document.body.dataset.pageType ?? "site",
                                    topic:
                                        document.body.dataset.topic ?? "general",
                                    cta_variant: link.dataset.umamiCtaVariant,
                                    destination: "app_store",
                                });
                            });
                        },
                        { threshold: 0.5 }
                    );

                    links.forEach((link) => observer.observe(link));
                    cleanupAppStoreCtaSeen = () => observer.disconnect();
                };

                let cleanupGuideEngagement = () => {};

                const setupGuideEngagement = () => {
                    const article = document.querySelector(
                        "article[data-guide-topic]"
                    );
                    const topic = article?.dataset.guideTopic;
                    cleanupGuideEngagement();

                    if (!article || !topic) return;

                    let reachedHalfway = false;
                    let spentThirtySeconds = false;
                    let tracked = false;

                    const trackEngagement = () => {
                        if (tracked || !reachedHalfway || !spentThirtySeconds) {
                            return;
                        }

                        if (typeof window.umami?.track !== "function") return;

                        tracked = true;
                        window.umami.track("guide_engaged", {
                            topic,
                            page_type: "guide",
                        });
                    };

                    const checkScrollDepth = () => {
                        const { top, height } = article.getBoundingClientRect();
                        reachedHalfway ||= top + height / 2 <= window.innerHeight;
                        trackEngagement();
                    };

                    const timer = window.setTimeout(() => {
                        spentThirtySeconds = true;
                        trackEngagement();
                    }, 30_000);

                    window.addEventListener("scroll", checkScrollDepth, {
                        passive: true,
                    });
                    window.addEventListener("resize", checkScrollDepth);
                    checkScrollDepth();

                    cleanupGuideEngagement = () => {
                        window.clearTimeout(timer);
                        window.removeEventListener("scroll", checkScrollDepth);
                        window.removeEventListener("resize", checkScrollDepth);
                    };
                };

                document.addEventListener("astro:before-swap", () => {
                    cleanupAppStoreCtaSeen();
                });
                document.addEventListener("astro:page-load", () => {
                    setupAppStoreCtaSeen();
                    setupGuideEngagement();
                });
            }
        </script>
    </body>
</html>
