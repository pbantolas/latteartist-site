---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";
import AppStoreCta from "../components/AppStoreCta.astro";
import GuideCard from "../components/GuideCard.astro";
import { guideSlug } from "../lib/guides";

interface Props {
    guide: CollectionEntry<"guides">;
    headings: { depth: number; slug: string; text: string }[];
}

const { guide, headings } = Astro.props;
const { data } = guide;
const currentSlug = guideSlug(guide.id);
const canonicalPath = `/learn/${currentSlug}/`;
const guideURL = new URL(canonicalPath, Astro.site);
const ogImage = data.ogImage
    ? new URL(data.ogImage, Astro.site).href
    : undefined;
const toc = headings.filter((heading) => heading.depth === 2);
const allGuides = await getCollection("guides");
const relatedGuides = data.related
    .map((id) => allGuides.find((entry) => guideSlug(entry.id) === id))
    .filter((entry): entry is CollectionEntry<"guides"> => Boolean(entry));

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: {
        "@type": "Person",
        name: "Petros",
    },
    publisher: {
        "@type": "Organization",
        name: "LatteArtist",
        url: Astro.site?.href,
    },
    image: ogImage ?? new URL("/assets/card-image.jpg", Astro.site).href,
    mainEntityOfPage: guideURL.href,
    keywords: data.keywords.join(", "),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
        { "@type": "ListItem", position: 2, name: "Learn", item: new URL("/learn/", Astro.site).href },
        { "@type": "ListItem", position: 3, name: data.title, item: guideURL.href },
    ],
};
---

<Layout
    title={`${data.title} | LatteArtist`}
    description={data.description}
    ogTitle={data.title}
    ogDescription={data.description}
    canonical={canonicalPath}
    type="article"
    ogImage={ogImage}
    twitterImage={ogImage}
    structuredData={[articleSchema, breadcrumbSchema]}
    pageType="guide"
    topic={currentSlug}
>
    <div class="mx-auto w-full max-w-6xl">
        <nav aria-label="Breadcrumb" class="mb-8 text-sm text-secondary">
            <ol class="flex flex-wrap items-center gap-2">
                <li><a href="/" class="hover:text-accent">Home</a></li>
                <li aria-hidden="true">/</li>
                <li><a href="/learn/" class="hover:text-accent">Learn</a></li>
                <li aria-hidden="true">/</li>
                <li aria-current="page" class="text-primary">{data.eyebrow}</li>
            </ol>
        </nav>

        <header class="guide-hero">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{data.eyebrow}</p>
            <h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-[-0.035em] text-primary sm:text-5xl lg:text-6xl">
                {data.title}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">{data.description}</p>
            <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-secondary">
                <span>By Petros</span>
                <span aria-hidden="true">•</span>
                <time datetime={data.updatedDate?.toISOString() ?? data.pubDate.toISOString()}>
                    Updated {(data.updatedDate ?? data.pubDate).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}
                </time>
                <span aria-hidden="true">•</span>
                <span>{data.readTime}</span>
            </div>
        </header>

        <div class="mt-12 grid items-start gap-10 lg:grid-cols-[14rem_minmax(0,1fr)]">
            {toc.length > 0 && (
                <aside class="top-28 rounded-2xl border border-black/5 bg-card p-5 lg:sticky dark:border-white/10">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary">In this guide</p>
                    <ol class="mt-4 space-y-3 text-sm leading-snug">
                        {toc.map((heading) => (
                            <li><a href={`#${heading.slug}`} class="text-secondary transition hover:text-accent">{heading.text}</a></li>
                        ))}
                    </ol>
                </aside>
            )}

            <article class="guide-prose prose prose-lg max-w-none dark:prose-invert" data-guide-topic={currentSlug}>
                <slot />
            </article>
        </div>

        <div class="mt-16">
            <AppStoreCta />
        </div>

        {relatedGuides.length > 0 && (
            <section class="mt-16" aria-labelledby="related-guides-heading">
                <div class="mb-7 flex items-end justify-between gap-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">Keep practising</p>
                        <h2 id="related-guides-heading" class="mt-2 text-3xl font-semibold text-primary">Related guides</h2>
                    </div>
                    <a href="/learn/" class="hidden font-semibold text-accent sm:block">All guides →</a>
                </div>
                <div class="grid gap-5 md:grid-cols-2">
                    {relatedGuides.map((entry) => (
                        <GuideCard
                            href={`/learn/${guideSlug(entry.id)}/`}
                            eyebrow={entry.data.eyebrow}
                            title={entry.data.title}
                            description={entry.data.description}
                            readTime={entry.data.readTime}
                        />
                    ))}
                </div>
            </section>
        )}
    </div>
</Layout>
